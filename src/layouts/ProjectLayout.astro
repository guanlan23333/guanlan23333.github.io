---
import BaseLayout from './BaseLayout.astro';
import StatusBadge from '../components/StatusBadge.astro';

const { project } = Astro.props;
const d = project.data;
---
<BaseLayout title={`${d.title}｜郭南焱项目案例`} description={d.summary}>
  <article class="case-study">
    <header class="case-hero">
      <a class="back-link" href="/projects/">← 返回所有项目</a>
      <div class="case-kicker"><StatusBadge status={d.status} /><span>{d.tags.join(' · ')}</span></div>
      <h1>{d.title}</h1>
      <p class="case-summary">{d.summary}</p>
      <dl class="case-facts">
        <div><dt>角色</dt><dd>{d.role}</dd></div>
        <div><dt>目标用户</dt><dd>{d.targetUsers.join('、')}</dd></div>
        <div><dt>最近更新</dt><dd>{d.lastUpdated.toLocaleDateString('zh-CN')}</dd></div>
        <div><dt>当前状态</dt><dd>{d.status === 'alpha' ? '可运行 Alpha' : '开发中'}</dd></div>
      </dl>
      <div class="case-actions">
        {d.demoUrl && <a class="button" href={d.demoUrl}>查看 Demo</a>}
        {d.githubUrl && <a class="button button-secondary" href={d.githubUrl}>GitHub</a>}
      </div>
    </header>

    <div class="case-grid">
      <aside class="case-toc" aria-label="案例目录">
        <strong>案例目录</strong>
        <a href="#snapshot">30 秒摘要</a>
        <a href="#context">背景与目标</a>
        <a href="#research">调研与洞察</a>
        <a href="#reframe">问题重定义</a>
        <a href="#solution">方案与决策</a>
        <a href="#architecture">系统工作流</a>
        <a href="#validation">验证与结果</a>
        <a href="#bad-cases">Bad Case</a>
        <a href="#reflection">复盘</a>
      </aside>
      <div class="case-content prose"><slot /></div>
    </div>
  </article>
</BaseLayout>
