---
import { profile } from '../data/profile';
---
<section class="contact-cta" aria-labelledby="contact-title">
  <div>
    <p class="eyebrow">Contact</p>
    <h2 id="contact-title">寻找 AI 产品与 Agent 应用实习机会</h2>
    <p>{profile.city} · {profile.availability}。项目源码与更新可在 GitHub 查看。</p>
  </div>
  <div class="hero-actions">
    <a class="button button-secondary" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
    <a class="button button-secondary" href="/resume/">查看公开简历</a>
  </div>
</section>
